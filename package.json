{
  "name": "hvdigital-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "server:dev": "cargo run --manifest-path server/Cargo.toml",
    "server:build": "cargo build --release --manifest-path server/Cargo.toml",
    "web:dev": "vite",
    "web:build": "npm run build && npm run server:build"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.4.1",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
